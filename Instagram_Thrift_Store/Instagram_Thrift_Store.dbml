// ==========================================
// INSTAGRAM THRIFT CREATOR STORE — ERD
// ==========================================

// 1. Customers — people who place orders
Table Customer {
  id                int      [pk, increment]
  full_name         varchar  [not null]
  instagram_handle  varchar  [unique, note: "Primary contact channel for DM-based orders"]
  phone             varchar  [unique]
  email             varchar  [unique]
  shipping_address  text     [note: "Default address; can be overridden per order"]
  joined_at         timestamp [not null]
}

// 2. ProductCategory — e.g., Tops, Bottoms, Accessories, Footwear, Handmade Decor
Table ProductCategory {
  id    int     [pk, increment]
  name  varchar [not null, unique]
}

// 3. Product — core catalog entry
// product_type distinguishes thrift (unique physical item) from handmade (batch producible).
// Thrift items have condition; handmade items may have multiple stock units.
Table Product {
  id              int      [pk, increment]
  category_id     int      [not null, ref: > ProductCategory.id]
  name            varchar  [not null]
  description     text
  product_type    varchar  [not null, note: "'THRIFT' or 'HANDMADE'"]
  price           decimal  [not null]
  size            varchar  [note: "XS / S / M / L / XL / Free Size / NA"]
  color           varchar
  condition       varchar  [note: "For THRIFT items: 'Like New', 'Good', 'Fair'. NULL for HANDMADE."]
  stock_quantity  int      [not null, default: 1, note: "THRIFT = always 1 max; HANDMADE = batch count"]
  is_available    boolean  [not null, default: true, note: "False when sold out or unlisted"]
  listed_at       timestamp [not null]

  // A THRIFT item should have stock_quantity = 1 at most — enforced at application level.
  // A HANDMADE item can have stock_quantity > 1.
}

// 4. ProductImage — multiple images per product (Instagram-style gallery)
Table ProductImage {
  id          int     [pk, increment]
  product_id  int     [not null, ref: > Product.id]
  image_url   varchar [not null]
  is_primary  boolean [not null, default: false]
  uploaded_at timestamp
}

// 5. Order — one customer's purchase event
Table Order {
  id            int       [pk, increment]
  customer_id   int       [not null, ref: > Customer.id]
  order_date    timestamp [not null]
  total_amount  decimal   [not null, note: "Sum of all OrderItem.subtotal values"]
  order_status  varchar   [not null, note: "'PENDING', 'CONFIRMED', 'SHIPPED', 'DELIVERED', 'CANCELLED'"]
  notes         text      [note: "Special instructions from customer via DM"]
}

// 6. OrderItem — junction table: one order can contain many products
// Each row represents one product line in an order.
Table OrderItem {
  id          int     [pk, increment]
  order_id    int     [not null, ref: > Order.id]
  product_id  int     [not null, ref: > Product.id]
  quantity    int     [not null, default: 1]
  unit_price  decimal [not null, note: "Snapshot of Product.price at time of order"]
  subtotal    decimal [not null, note: "unit_price × quantity"]

  indexes {
    (order_id, product_id) [name: "idx_orderitem_lookup"]
  }
}

// 7. Payment — financial record linked 1-to-1 with an Order
Table Payment {
  id              int       [pk, increment]
  order_id        int       [unique, not null, ref: - Order.id]  // 1-to-1
  amount          decimal   [not null]
  payment_method  varchar   [note: "UPI, Cash on Delivery, Bank Transfer, Card"]
  payment_status  varchar   [not null, note: "'PENDING', 'COMPLETED', 'FAILED', 'REFUNDED'"]
  transaction_ref varchar   [note: "UPI transaction ID or reference number"]
  paid_at         timestamp [note: "NULL until payment confirmed"]
}

// 8. Shipment — delivery tracking linked 1-to-1 with an Order
Table Shipment {
  id                 int       [pk, increment]
  order_id           int       [unique, not null, ref: - Order.id]  // 1-to-1
  tracking_number    varchar   [unique, note: "Courier tracking ID"]
  carrier            varchar   [note: "Delhivery, India Post, Dunzo, etc."]
  shipping_address   text      [not null, note: "Captured at time of shipping; may differ from customer default"]
  shipped_at         timestamp
  estimated_delivery timestamp
  delivered_at       timestamp [note: "NULL until physically delivered"]
  shipment_status    varchar   [not null, note: "'PENDING', 'PACKED', 'IN_TRANSIT', 'OUT_FOR_DELIVERY', 'DELIVERED', 'RETURNED'"]
}
